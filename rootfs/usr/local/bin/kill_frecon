#!/bin/bash

#this script stops frecon (the terminal used by the bootloader) so that xorg or
#wayland can take over the display

umount -l /dev/console 2>/dev/null || true
pkill -x frecon-lite 2>/dev/null || true

#wait until frecon has really exited and let go of the gpu. if the display
#server starts before that, it can fail to take over and leave a black screen.
for _ in $(seq 1 50); do
  if ! pgrep -x frecon-lite > /dev/null; then
    exit 0
  fi
  sleep 0.1
done
pkill -9 -x frecon-lite 2>/dev/null || true
exit 0
