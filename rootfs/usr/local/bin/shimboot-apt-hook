#!/bin/bash

#run by apt after every package installation or upgrade (see /etc/apt/apt.conf.d/99reshimboot)

#debian's alsa-ucm-conf package overwrites the chromebook audio configs when it
#is upgraded, so put them back
if [ -d /usr/share/reshimboot/ucm2 ] && [ -d /usr/share/alsa/ucm2 ]; then
  cp -a /usr/share/reshimboot/ucm2/. /usr/share/alsa/ucm2/
fi

#an unpatched systemd cannot boot with the shim kernel. the image build
#checks this itself, after the patched systemd has been installed.
if [ "$RESHIMBOOT_BUILD" = "1" ]; then
  exit 0
fi
installed="$(dpkg-query -W -f='${Version}' systemd 2>/dev/null)"
unpatched=""
fix_cmd=""
if [ -d /var/lib/reshimboot/systemd-repo ]; then
  #built by build_systemd.sh, these always have a "+reshimboot" version
  if [ "$installed" ] && [[ "$installed" != *+reshimboot* ]]; then
    unpatched="1"
    fix_cmd="sudo shimboot-doctor --fix"
  fi
elif ls /var/lib/apt/lists/*shimboot*_Packages > /dev/null 2>&1; then
  if [ "$installed" ] && ! apt-cache madison systemd 2>/dev/null | grep shimboot | grep -qF " $installed "; then
    unpatched="1"
    fix_cmd="sudo apt update && sudo apt install --reinstall --allow-downgrades systemd libsystemd-shared libsystemd0"
  fi
fi
if [ "$unpatched" ]; then
  printf '\033[1;31m%s\033[0m\n' \
    "WARNING: systemd $installed is not the patched version that the shim kernel needs." \
    "The system will most likely fail to boot. Do not reboot until this is fixed:" \
    "  $fix_cmd" >&2
fi
exit 0
